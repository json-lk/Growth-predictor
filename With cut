import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import GridSearchCV, TimeSeriesSplit

# =====================================================================
# CONFIGURATION
# =====================================================================

TARGET_CODE = 'NY.GDP.MKTP.KD.ZG'
TARGET_NAME = "Real GDP Growth (annual %)"
HISTORICAL_CUTOFF_YEARS = 20  # Number of recent years to cut off for testing
CRISIS_YEARS = {2008, 2009, 2020}  # Known global shock years

COUNTRY_FILES = {
    'Ghana': 'ghana.csv',
    'Egypt': 'egypt.csv',
    'Nigeria': 'nigeria.csv',
    'Togo': 'togo.csv',
    'Zambia': 'zambia.csv',
    'Ivory Coast': 'ivory.csv',
}


# =====================================================================
# DATA INGESTION & AUTO-CLEANING
# =====================================================================


def load_worldbank_csv(file_path, target_code):
    try:
        skip_rows = 0
        with open(file_path, 'r', encoding='latin1') as f:
            first_lines = [f.readline() for _ in range(5)]
            if any('Data Source' in line for line in first_lines):
                skip_rows = 4

        df = pd.read_csv(
            file_path,
            skiprows=skip_rows,
            encoding='latin1',
            on_bad_lines='skip',
            na_values=['..', '', ' ', 'NaN', 'null'],
        )

        df.columns = df.columns.str.strip()
        code_col = (
            'Indicator Code'
            if 'Indicator Code' in df.columns
            else 'Series Code'
        )

        if code_col not in df.columns:
            return None

        filtered_df = df[
            df[code_col].astype(str).str.strip() == target_code.strip()
        ]
        if filtered_df.empty:
            return None

        year_cols = [
            c for c in filtered_df.columns if pd.Series(c).str.contains(r'\d{4}').any()
        ]
        years_parsed = (
            pd.Series(year_cols).str.extract(r'(\d{4})')[0].astype(int).values
        )
        values_parsed = pd.to_numeric(
            filtered_df[year_cols].values.flatten(), errors='coerce'
        )

        clean_df = (
            pd.DataFrame({'Year': years_parsed, 'Value': values_parsed})
            .dropna(subset=['Year'])
            .sort_values(by='Year')
            .reset_index(drop=True)
        )

        clean_df['Year'] = clean_df['Year'].astype(int)
        clean_df['Value'] = clean_df['Value'].interpolate(
            method='linear', limit_direction='both'
        )

        # Automated Quantile-based Outlier Clipping (Per country statistical bounds)
        lower_bound = clean_df['Value'].quantile(0.025)
        upper_bound = clean_df['Value'].quantile(0.975)
        clean_df['Value_Clipped'] = clean_df['Value'].clip(lower_bound, upper_bound)

        return clean_df

    except FileNotFoundError:
        print(f"Warning: File non-existent -> {file_path}")
        return None
    except Exception as err:
        print(f"Failed parsing {file_path}: {err}")
        return None


# =====================================================================
# AUTOMATED FEATURE GENERATION ENGINE
# =====================================================================


def generate_lag_features(df, max_lags=4):
    """Generates features dynamically based on variable lag depth."""
    data = df.copy()
    feature_cols = []

    for lag in range(1, max_lags + 1):
        col_name = f'Lag_{lag}'
        data[col_name] = data['Value_Clipped'].shift(lag)
        feature_cols.append(col_name)

    data['Rolling_Mean'] = data['Value_Clipped'].shift(1).rolling(3).mean()
    data['Rolling_Std'] = data['Value_Clipped'].shift(1).rolling(3).std().fillna(0)
    data['Crisis_Year'] = data['Year'].apply(lambda y: 1 if y in CRISIS_YEARS else 0)

    feature_cols.extend(['Rolling_Mean', 'Rolling_Std', 'Crisis_Year'])
    return data, feature_cols


# =====================================================================
# AUTOMATED MODEL LEARNING & TUNING ENGINE
# =====================================================================


def auto_train_and_forecast(train_df, test_years):
    """
    1. Evaluates multiple lag configurations.
    2. Uses TimeSeriesSplit CV & GridSearch to automatically tune Random Forest parameters.
    3. Recursively forecasts across test horizon.
    """
    best_overall_score = float('inf')
    best_model = None
    best_lags = 3
    best_features_df = None
    best_feature_cols = None

    # Auto-find optimal lag depth (2 to 5 years)
    for lags in range(2, 6):
        df_feat, feature_cols = generate_lag_features(train_df, max_lags=lags)
        df_clean_feat = df_feat.dropna()

        if len(df_clean_feat) < 8:
            continue

        X = df_clean_feat[feature_cols]
        y = df_clean_feat['Value_Clipped']

        # Time Series Cross-Validation Splitter
        tscv = TimeSeriesSplit(n_splits=min(3, len(X) - 2))

        # Hyperparameter Tuning Grid
        param_grid = {
            'n_estimators': [50, 100, 150],
            'max_depth': [3, 5, None],
            'min_samples_split': [2, 4],
        }

        grid = GridSearchCV(
            estimator=RandomForestRegressor(random_state=42),
            param_grid=param_grid,
            cv=tscv,
            scoring='neg_mean_squared_error',
            n_jobs=-1,
        )
        grid.fit(X, y)

        if abs(grid.best_score_) < best_overall_score:
            best_overall_score = abs(grid.best_score_)
            best_model = grid.best_estimator_
            best_lags = lags
            best_features_df = df_clean_feat
            best_feature_cols = feature_cols

    if best_model is None:  # Fallback if dataset is too small
        return np.full(len(test_years), train_df['Value'].mean())

    # Recursive multi-step prediction using the automatically selected best model
    predictions = []
    history = list(train_df['Value_Clipped'].values)

    for year in test_years:
        input_dict = {}

        # Fill lag values dynamically based on selected lag size
        for lag in range(1, best_lags + 1):
            input_dict[f'Lag_{lag}'] = history[-lag]

        input_dict['Rolling_Mean'] = np.mean(history[-3:])
        input_dict['Rolling_Std'] = np.std(history[-3:])
        input_dict['Crisis_Year'] = 1 if year in CRISIS_YEARS else 0

        X_next = pd.DataFrame([input_dict])[best_feature_cols]

        pred_val = best_model.predict(X_next)[0]
        predictions.append(pred_val)
        history.append(pred_val)

    return np.array(predictions)


# =====================================================================
# MAIN PIPELINE
# =====================================================================

raw_series = {}
for country_name, file_name in COUNTRY_FILES.items():
    df_clean = load_worldbank_csv(file_name, TARGET_CODE)
    if df_clean is not None and not df_clean.empty:
        raw_series[country_name] = df_clean

plt.style.use(
    'seaborn-v0_8-whitegrid'
    if 'seaborn-v0_8-whitegrid' in plt.style.available
    else 'default'
)
fig, ax = plt.subplots(figsize=(14, 8), dpi=100)

cmap = plt.get_cmap('tab10')
country_colors = {
    country: cmap(i % 10) for i, country in enumerate(raw_series.keys())
}

for country_name, df_data in raw_series.items():
    color = country_colors[country_name]

    if len(df_data) > HISTORICAL_CUTOFF_YEARS + 5:
        train_df = df_data.iloc[:-HISTORICAL_CUTOFF_YEARS].reset_index(drop=True)
        test_df = df_data.iloc[-HISTORICAL_CUTOFF_YEARS:].reset_index(drop=True)
    else:
        continue

    train_years = train_df['Year'].values
    train_values = train_df['Value'].values
    test_years = test_df['Year'].values
    actual_test_values = test_df['Value'].values

    # Automated Learning and Forecasting
    ml_predictions = auto_train_and_forecast(train_df, test_years)

    # Plot train history
    ax.plot(
        train_years,
        train_values,
        label=f'{country_name} (Train)',
        color=color,
        linewidth=1.8,
    )

    # Plot actual test target values
    ax.plot(
        test_years,
        actual_test_values,
        linestyle='--',
        color=color,
        alpha=0.5,
        linewidth=1.5,
    )

    # Plot automatically tuned ML prediction line
    connect_years = np.append([train_years[-1]], test_years)
    connect_preds = np.append([train_values[-1]], ml_predictions)

    ax.plot(
        connect_years,
        connect_preds,
        linestyle=':',
        marker='o',
        markersize=3,
        linewidth=2.0,
        color=color,
        label=f'{country_name} (Auto-Tuned ML)',
    )

cutoff_start_year = test_years[0]
ax.axvline(
    x=cutoff_start_year - 0.5,
    color='#333333',
    linestyle='--',
    linewidth=1.5,
    label='Backtest Cutoff Point',
)
ax.axhline(0, color='black', linewidth=0.9, alpha=0.8)

ax.set_title(
    f'Automated ML Forecasting (GridSearch CV & TimeSeriesSplit)\n{TARGET_NAME}',
    fontsize=14,
    fontweight='bold',
    pad=15,
)
ax.set_xlabel('Year', fontsize=11, fontweight='bold', labelpad=10)
ax.set_ylabel('Annual Growth Rate (%)', fontsize=11, fontweight='bold', labelpad=10)

ax.legend(
    loc='upper left',
    bbox_to_anchor=(1.01, 1),
    frameon=True,
    facecolor='white',
    edgecolor='#cccccc',
    fontsize=8.5,
)

plt.tight_layout()
plt.show()
