import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor

# =====================================================================
# CONFIGURATION
# =====================================================================

TARGET_CODE = 'NY.GDP.MKTP.KD.ZG'
TARGET_NAME = "Real GDP Growth (annual %)"
HISTORICAL_CUTOFF_YEARS = 20  # Number of recent years to cut off for testing
CRISIS_YEARS = {2008, 2009, 2020}  # Major global shock years

COUNTRY_FILES = {
    'Ghana': 'ghana.csv',
    'Egypt': 'egypt.csv',
    'Nigeria': 'nigeria.csv',
    'Togo': 'togo.csv',
    'Zambia': 'zambia.csv',
    'Ivory Coast': 'ivory.csv',
}


# =====================================================================
# DATA INGESTION & CLEANING
# =====================================================================


def load_worldbank_csv(file_path, target_code):
    try:
        skip_rows = 0
        with open(file_path, 'r', encoding='latin1') as f:
            first_lines = [f.readline() for _ in range(5)]
            if any('Data Source' in line for line in first_lines):
                skip_rows = 4

        df = pd.read_csv(
            file_path,
            skiprows=skip_rows,
            encoding='latin1',
            on_bad_lines='skip',
            na_values=['..', '', ' ', 'NaN', 'null'],
        )

        df.columns = df.columns.str.strip()
        code_col = (
            'Indicator Code'
            if 'Indicator Code' in df.columns
            else 'Series Code'
        )

        if code_col not in df.columns:
            return None

        filtered_df = df[
            df[code_col].astype(str).str.strip() == target_code.strip()
        ]
        if filtered_df.empty:
            return None

        year_cols = [
            c for c in filtered_df.columns if pd.Series(c).str.contains(r'\d{4}').any()
        ]
        years_parsed = (
            pd.Series(year_cols).str.extract(r'(\d{4})')[0].astype(int).values
        )
        values_parsed = pd.to_numeric(
            filtered_df[year_cols].values.flatten(), errors='coerce'
        )

        clean_df = (
            pd.DataFrame({'Year': years_parsed, 'Value': values_parsed})
            .dropna(subset=['Year'])
            .sort_values(by='Year')
            .reset_index(drop=True)
        )

        clean_df['Year'] = clean_df['Year'].astype(int)
        clean_df['Value'] = clean_df['Value'].interpolate(
            method='linear', limit_direction='both'
        )

        # Clip extreme macroeconomic outliers (-15% to +20%)
        clean_df['Value_Clipped'] = clean_df['Value'].clip(-15.0, 20.0)

        return clean_df

    except FileNotFoundError:
        print(f"Warning: File non-existent -> {file_path}")
        return None
    except Exception as err:
        print(f"Failed parsing {file_path}: {err}")
        return None


# =====================================================================
# FEATURE ENGINEERING & RECURSIVE ML ENGINE
# =====================================================================


def build_features(df):
    """Creates lag and rolling statistical features for ML model training."""
    data = df.copy()
    data['Lag_1'] = data['Value_Clipped'].shift(1)
    data['Lag_2'] = data['Value_Clipped'].shift(2)
    data['Lag_3'] = data['Value_Clipped'].shift(3)
    data['Rolling_Mean_3'] = data['Value_Clipped'].shift(1).rolling(3).mean()
    data['Rolling_Std_3'] = data['Value_Clipped'].shift(1).rolling(3).std().fillna(0)
    data['Crisis_Year'] = data['Year'].apply(lambda y: 1 if y in CRISIS_YEARS else 0)
    return data


def train_and_forecast_ml(train_df, test_years):
    """
    Trains a Random Forest Regressor on historical training data
    and recursively forecasts values for future/test years.
    """
    # Build training features
    df_feat = build_features(train_df).dropna()
    feature_cols = ['Lag_1', 'Lag_2', 'Lag_3', 'Rolling_Mean_3', 'Rolling_Std_3', 'Crisis_Year']

    X_train = df_feat[feature_cols]
    y_train = df_feat['Value_Clipped']

    if len(X_train) < 5:  # Fallback if insufficient historical data
        return np.full(len(test_years), train_df['Value'].mean())

    # Fit Random Forest Regressor
    model = RandomForestRegressor(n_estimators=100, random_state=42)
    model.fit(X_train, y_train)

    # Recursive forecasting across test/horizon years
    predictions = []
    history_values = list(train_df['Value_Clipped'].values)

    for year in test_years:
        lag1 = history_values[-1]
        lag2 = history_values[-2]
        lag3 = history_values[-3]
        roll_mean = np.mean(history_values[-3:])
        roll_std = np.std(history_values[-3:])
        is_crisis = 1 if year in CRISIS_YEARS else 0

        X_next = pd.DataFrame([{
            'Lag_1': lag1,
            'Lag_2': lag2,
            'Lag_3': lag3,
            'Rolling_Mean_3': roll_mean,
            'Rolling_Std_3': roll_std,
            'Crisis_Year': is_crisis
        }])

        pred_val = model.predict(X_next)[0]
        predictions.append(pred_val)
        history_values.append(pred_val)  # Append prediction to history for subsequent lags

    return np.array(predictions)


# =====================================================================
# MAIN PIPELINE
# =====================================================================

raw_series = {}
for country_name, file_name in COUNTRY_FILES.items():
    df_clean = load_worldbank_csv(file_name, TARGET_CODE)
    if df_clean is not None and not df_clean.empty:
        raw_series[country_name] = df_clean

plt.style.use(
    'seaborn-v0_8-whitegrid'
    if 'seaborn-v0_8-whitegrid' in plt.style.available
    else 'default'
)
fig, ax = plt.subplots(figsize=(14, 8), dpi=100)

cmap = plt.get_cmap('tab10')
country_colors = {
    country: cmap(i % 10) for i, country in enumerate(raw_series.keys())
}

for country_name, df_data in raw_series.items():
    color = country_colors[country_name]

    # Split into Train set (older history) and Test set (most recent 20 years)
    if len(df_data) > HISTORICAL_CUTOFF_YEARS + 5:
        train_df = df_data.iloc[:-HISTORICAL_CUTOFF_YEARS].reset_index(drop=True)
        test_df = df_data.iloc[-HISTORICAL_CUTOFF_YEARS:].reset_index(drop=True)
    else:
        continue

    train_years = train_df['Year'].values
    train_values = train_df['Value'].values
    test_years = test_df['Year'].values
    actual_test_values = test_df['Value'].values

    # Generate ML Predictions for the test window
    ml_predictions = train_and_forecast_ml(train_df, test_years)

    # Plot training history (Solid Line)
    ax.plot(
        train_years,
        train_values,
        label=f'{country_name} (Train)',
        color=color,
        linewidth=1.8,
    )

    # Plot actual test values (Dashed Line)
    ax.plot(
        test_years,
        actual_test_values,
        linestyle='--',
        color=color,
        alpha=0.5,
        linewidth=1.5,
    )

    # Plot ML Forecast (Dotted Line with Markers)
    connect_years = np.append([train_years[-1]], test_years)
    connect_preds = np.append([train_values[-1]], ml_predictions)

    ax.plot(
        connect_years,
        connect_preds,
        linestyle=':',
        marker='o',
        markersize=3,
        linewidth=2.0,
        color=color,
        label=f'{country_name} (ML Forecast)',
    )

# Vertical line marking split point
cutoff_start_year = test_years[0]
ax.axvline(
    x=cutoff_start_year - 0.5,
    color='#333333',
    linestyle='--',
    linewidth=1.5,
    label='Backtest Cutoff Point',
)
ax.axhline(0, color='black', linewidth=0.9, alpha=0.8)

ax.set_title(
    f'Machine Learning Backtest (Random Forest with Lag Features)\n{TARGET_NAME}',
    fontsize=14,
    fontweight='bold',
    pad=15,
)
ax.set_xlabel('Year', fontsize=11, fontweight='bold', labelpad=10)
ax.set_ylabel('Annual Growth Rate (%)', fontsize=11, fontweight='bold', labelpad=10)

ax.legend(
    loc='upper left',
    bbox_to_anchor=(1.01, 1),
    frameon=True,
    facecolor='white',
    edgecolor='#cccccc',
    fontsize=8.5,
)

plt.tight_layout()
plt.show()
