import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. SETUP PARAMETERS & FILES
# ==========================================

# Define your target indicator code here (change this code to switch metrics)
TARGET_CODE = 'NY.GDP.MKTP.KD.ZG'  # Real GDP Growth (annual %)
TARGET_NAME = "Real GDP Growth (annual %)" # Human-readable label for the chart

# Map your separate CSV filenames to their respective country names
country_files = {
    'Ghana': 'ghana_wb_data.csv',
    'Vietnam': 'vietnam_wb_data.csv',
    'Georgia': 'georgia_wb_data.csv',
    'Morocco': 'morocco_wb_data.csv',
    'Botswana': 'botswana_wb_data.csv'
}

# Initialize a clean Matplotlib figure
plt.figure(figsize=(12, 6.5))

# ==========================================
# 2. PROCESSING PIPELINE (ITERATE FILES)
# ==========================================

for country, file_path in country_files.items():
    try:
        # Load the individual CSV file
        df = pd.read_csv(file_path, na_values=['..', '', ' ', 'NaN'])
        
        # Clean column spaces to prevent key errors
        df.columns = df.columns.str.strip()
        
        # --- WORLD BANK FILTERING LOGIC ---
        # Manual downloads usually have an 'Indicator Code' or 'Series Code' column.
        # We find the row matching our target code.
        code_column = 'Indicator Code' if 'Indicator Code' in df.columns else 'Series Code'
        
        # Filter the DataFrame for only the target metric row
        filtered_df = df[df[code_column].str.strip() == TARGET_CODE]
        
        if filtered_df.empty:
            print(f"Warning: Code {TARGET_CODE} not found in {file_path}")
            continue
            
        # Extract the years (columns) and values (row data)
        # We drop metadata columns to isolate the time-series numeric columns
        metadata_cols = ['Country Name', 'Country Code', 'Indicator Name', 'Indicator Code', 'Series Name', 'Series Code']
        time_series_data = filtered_df.drop(columns=[col for col in metadata_cols if col in filtered_df.columns])
        
        # Convert columns (Years) to numeric, and row values to numeric
        years = pd.to_numeric(time_series_data.columns.str.extract(r'(\d{4})')[0], errors='coerce')
        values = pd.to_numeric(time_series_data.values[0], errors='coerce')
        
        # Combine into a clean temporary DataFrame for sorting and cleaning
        plot_df = pd.DataFrame({'Year': years, 'Value': values}).dropna(subset=['Year'])
        plot_df = plot_df.sort_values(by='Year')
        
        # Handle internal missing data using NumPy/Pandas interpolation
        plot_df['Value'] = plot_df['Value'].ffill().bfill()
        
        # --- CUSTOM MATPLOTLIB VISUAL STYLING ---
        # Make Ghana stand out with a thick solid line, and peers with dashed lines
        if country == 'Ghana':
            line_style = '-'
            line_width = 3.5
            alpha_val = 1.0
            color_val = '#D62728' # Distinct strong red
        else:
            line_style = '--'
            line_width = 1.7
            alpha_val = 0.75
            color_val = None # Let matplotlib assign distinct loop colors
            
        # Plot this country's line onto the single unified graph
        plt.plot(
            plot_df['Year'], 
            plot_df['Value'], 
            label=country, 
            linestyle=line_style, 
            linewidth=line_width, 
            alpha=alpha_val,
            color=color_val
        )
        
    except FileNotFoundError:
        print(f"Skipping: File '{file_path}' not found. Check your directory.")
    except Exception as e:
        print(f"Error processing {country}: {e}")

# ==========================================
# 3. CHART FINISHING & RENDERING
# ==========================================

plt.title(f"Ghana vs. Global Peers: {TARGET_NAME}\n[Indicator: {TARGET_CODE}]", fontsize=14, fontweight='bold', pad=15)
plt.xlabel("Year", fontsize=12, fontweight='bold')
plt.ylabel("Value (%)", fontsize=12, fontweight='bold')

plt.grid(True, linestyle=':', alpha=0.6)
plt.axhline(0, color='black', linewidth=0.8, linestyle='-') # Base reference line at 0%

# Place the legend cleanly inside the plot space
plt.legend(loc='best', frameon=True, facecolor='white', edgecolor='none', fontsize=11)
plt.tight_layout()

# Render the single graph
plt.show()
