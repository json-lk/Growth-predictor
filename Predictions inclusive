        df_data['Year'],
        df_data['Value'],
        label=f'{country_name}',
        linestyle='--',
        alpha=0.45,
        linewidth=1.4,
        color=c,
    )
    peer_idx += 1

if 'Ghana' in historical_series:
    gha_df = historical_series['Ghana']
    gha_years = gha_df['Year'].values
    gha_values = gha_df['Value'].values

    future_years = np.arange(FORECAST_START, FORECAST_START + FORECAST_HORIZON)
    connect_years = np.append([gha_years[-1]], future_years)

    baseline_pred, lower_ci, upper_ci = generate_damped_forecast(
        gha_years, gha_values, future_years
    )

    connect_baseline = np.append([gha_values[-1]], baseline_pred)
    connect_lower = np.append([gha_values[-1]], lower_ci)
    connect_upper = np.append([gha_values[-1]], upper_ci)

    accelerated_pred = baseline_pred + 2.0
    connect_accelerated = np.append([gha_values[-1]], accelerated_pred)

    ax.plot(
        gha_years,
        gha_values,
        label='Ghana (Actual)',
        color=COLORS['Ghana'],
        linewidth=3.2,
        zorder=4,
    )

    ax.plot(
        connect_years,
        connect_baseline,
        label='Ghana: Damped Trend Forecast',
        color=COLORS['Baseline'],
        linestyle=':',
        linewidth=2.5,
        zorder=3,
    )

    ax.plot(
        connect_years,
        connect_accelerated,
        label='Ghana: Peer-Accelerated Target (+2.0%)',
        color=COLORS['Accelerated'],
        linestyle='-.',
        linewidth=2.5,
        zorder=3,
    )

    ax.fill_between(
        connect_years,
        connect_lower,
        connect_upper,
        color=COLORS['Baseline'],
        alpha=0.12,
        label='80% Forecast Confidence Interval',
    )

    ax.annotate(
        f'{baseline_pred[-1]:.1f}%',
        xy=(future_years[-1], baseline_pred[-1]),
        xytext=(5, -3),
        textcoords='offset points',
        fontsize=9,
        fontweight='bold',
        color=COLORS['Baseline'],
    )

    ax.annotate(
        f'{accelerated_pred[-1]:.1f}%',
        xy=(future_years[-1], accelerated_pred[-1]),
        xytext=(5, -3),
        textcoords='offset points',
        fontsize=9,
        fontweight='bold',
        color=COLORS['Accelerated'],
    )

last_hist_yr = (
    historical_series['Ghana']['Year'].max()
    if 'Ghana' in historical_series
    else 2026
)
ax.axvspan(
    last_hist_yr,
    FORECAST_START + FORECAST_HORIZON - 1,
    color='gray',
    alpha=0.06,
    zorder=1,
)
ax.axvline(
    x=last_hist_yr,
    color='#555555',
    linestyle='--',
    alpha=0.7,
    linewidth=1.2,
    label='Forecast Horizon Start',
)
ax.axhline(0, color='black', linewidth=0.9, alpha=0.8)

ax.set_title(
    f'Ghana Economic Growth Blueprint vs. Peer Benchmark Economies\n{TARGET_NAME}',
    fontsize=14,
    fontweight='bold',
    pad=15,
)
ax.set_xlabel('Year', fontsize=11, fontweight='bold', labelpad=10)
ax.set_ylabel('Annual Growth Rate (%)', fontsize=11, fontweight='bold', labelpad=10)
ax.set_xlim(left=1995, right=FORECAST_START + FORECAST_HORIZON)

ax.legend(
    loc='upper left',
    frameon=True,
    facecolor='white',
    edgecolor='#cccccc',
    framealpha=0.95,
    fontsize=9.5,
)

plt.tight_layout()
plt.show()

