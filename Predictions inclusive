import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.stats import linregress

# CONFIG
target = 'NY.GDP.MKTP.KD.ZG'
start_yr = 2027
horizon = 5

# list of my files
files = ['ghana.csv', 'egypt.csv', 'nigeria.csv', 'togo.csv', 'zambia.csv', 'ivory.csv']
names = ['Ghana', 'Egypt', 'Nigeria', 'Togo', 'Zambia', 'Ivory Coast']

# empty dict to store data
data_dict = {}

# loop through all files (copy pasted logic)
for i in range(len(files)):
    fname = files[i]
    cname = names[i]
    
    try:
        # try reading with 4 skiprows first
        df = pd.read_csv(fname, skiprows=4, encoding='latin1', on_bad_lines='skip')
    except:
        # if fail try no skiprows
        df = pd.read_csv(fname, encoding='latin1', on_bad_lines='skip')
        
    # fix column spaces
    new_cols = []
    for c in df.columns:
        new_cols.append(str(c).strip())
    df.columns = new_cols
    
    # check indicator code column
    if 'Indicator Code' in df.columns:
        code_col = 'Indicator Code'
    else:
        code_col = 'Series Code'
        
    # filter for gdp growth
    sub_df = df[df[code_col] == target]
    
    if len(sub_df) > 0:
        # find year columns
        yrs = []
        vals = []
        for col in sub_df.columns:
            # check if col name has 4 digits
            if len(col) == 4 and col.isdigit():
                yrs.append(int(col))
                v = sub_df[col].values[0]
                # replace bad values manually
                if str(v) == '..' or str(v) == '' or str(v) == 'nan':
                    vals.append(np.nan)
                else:
                    try:
                        vals.append(float(v))
                    except:
                        vals.append(np.nan)
                        
        # make temp dataframe
        temp = pd.DataFrame({'year': yrs, 'val': vals})
        temp = temp.dropna(subset=['year'])
        temp = temp.sort_values('year')
        
        # fill missing values
        temp['val'] = temp['val'].interpolate(method='linear')
        temp['val'] = temp['val'].bfill().ffill() # just in case
        
        data_dict[cname] = temp

# SETUP PLOT
plt.figure(figsize=(12, 7))

# colors for plot
my_colors = ['blue', 'orange', 'green', 'red', 'purple', 'brown']

future_yrs = []
for y in range(start_yr, start_yr + horizon):
    future_yrs.append(y)
future_yrs = np.array(future_yrs)

max_yr = 2026

# MAIN LOOP FOR PLOTTING AND PREDICTION
counter = 0
for name in names:
    if name not in data_dict:
        continue
        
    df_country = data_dict[name]
    x_hist = df_country['year'].values
    y_hist = df_country['val'].values
    col = my_colors[counter]
    counter = counter + 1
    
    if x_hist[-1] > max_yr:
        max_yr = x_hist[-1]
        
    # plot history line
    if name == 'Ghana':
        plt.plot(x_hist, y_hist, label=name, color=col, linewidth=3)
    else:
        plt.plot(x_hist, y_hist, label=name, color=col, linewidth=1.5)
        
    # FORECAST LOGIC (Linear regression on last 10 points)
    recent_x = x_hist[-10:]
    recent_y = y_hist[-10:]
    
    slope, intercept, r_value, p_value, std_err = linregress(recent_x, recent_y)
    
    if np.isnan(slope):
        slope = 0.0
        
    last_val = y_hist[-1]
    last_yr = x_hist[-1]
    
    preds = []
    damp = 0.85
    
    # manual loop for predictions
    for idx in range(len(future_yrs)):
        fy = future_yrs[idx]
        step = fy - last_yr
        eff_slope = slope * (damp ** step)
        
        if idx == 0:
            next_val = last_val + eff_slope
        else:
            next_val = preds[-1] + eff_slope
            
        preds.append(next_val)
        
    preds = np.array(preds)
    
    # error band calculation
    if std_err is None or np.isnan(std_err):
        err = 0.5
    else:
        err = std_err
        
    margin = []
    for fy in future_yrs:
        m = 1.28 * err * np.sqrt(fy - last_yr)
        margin.append(m)
    margin = np.array(margin)
    
    low_band = preds - margin
    high_band = preds + margin
    
    # connect history to forecast
    cx = np.array([x_hist[-1]] + list(future_yrs))
    cy = np.array([y_hist[-1]] + list(preds))
    clow = np.array([y_hist[-1]] + list(low_band))
    chigh = np.array([y_hist[-1]] + list(high_band))
    
    # plot dotted forecast line
    plt.plot(cx, cy, ':', color=col, linewidth=2)
    
    # plot shaded area
    plt.fill_between(cx, clow, chigh, color=col, alpha=0.1)
    
    # print text at end of line
    plt.text(future_yrs[-1] + 0.2, preds[-1], str(round(preds[-1], 1)) + '%', color=col, fontsize=9, fontweight='bold')

# GRID & LABELS
plt.axvline(x=max_yr, color='gray', linestyle='--')
plt.axhline(y=0, color='black', linewidth=1)

plt.title('GDP Growth Prediction\n' + target, fontsize=12)
plt.xlabel('Year')
plt.ylabel('Growth Rate %')
plt.xlim(1995, 2033)
plt.grid(True)
plt.legend(loc='upper left')

plt.show()
