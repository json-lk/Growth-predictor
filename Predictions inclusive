import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.stats import linregress

# =====================================================================
# CONFIGURATION
# =====================================================================

TARGET_CODE = 'NY.GDP.MKTP.KD.ZG'
TARGET_NAME = "Real GDP Growth (annual %)"
FORECAST_START = 2027
FORECAST_HORIZON = 5

COUNTRY_FILES = {
    'Ghana': 'ghana_wb_data.csv',
    'Vietnam': 'vietnam_wb_data.csv',
    'Georgia': 'georgia_wb_data.csv',
    'Morocco': 'morocco_wb_data.csv',
    'Botswana': 'botswana_wb_data.csv',
}

# Unique colors assigned per country for clarity
COUNTRY_COLORS = {
    'Ghana': '#1f77b4',
    'Vietnam': '#2ca02c',
    'Georgia': '#ff7f0e',
    'Morocco': '#9467bd',
    'Botswana': '#8c564b',
}

ACCELERATED_COLOR = '#d62728'


# =====================================================================
# DATA INGESTION
# =====================================================================


def load_worldbank_csv(file_path, target_code):
    try:
        skip_rows = 0
        with open(file_path, 'r', encoding='latin1') as f:
            first_lines = [f.readline() for _ in range(5)]
            if any('Data Source' in line for line in first_lines):
                skip_rows = 4

        df = pd.read_csv(
            file_path,
            skiprows=skip_rows,
            encoding='latin1',
            on_bad_lines='skip',
            na_values=['..', '', ' ', 'NaN', 'null'],
        )

        df.columns = df.columns.str.strip()
        code_col = (
            'Indicator Code'
            if 'Indicator Code' in df.columns
            else 'Series Code'
        )

        if code_col not in df.columns:
            return None

        filtered_df = df[
            df[code_col].astype(str).str.strip() == target_code.strip()
        ]
        if filtered_df.empty:
            return None

        year_cols = [
            c for c in filtered_df.columns if pd.Series(c).str.contains(r'\d{4}').any()
        ]
        years_parsed = (
            pd.Series(year_cols).str.extract(r'(\d{4})')[0].astype(int).values
        )
        values_parsed = pd.to_numeric(
            filtered_df[year_cols].values.flatten(), errors='coerce'
        )

        clean_df = (
            pd.DataFrame({'Year': years_parsed, 'Value': values_parsed})
            .dropna(subset=['Year'])
            .sort_values(by='Year')
            .reset_index(drop=True)
        )

        clean_df['Year'] = clean_df['Year'].astype(int)
        clean_df['Value'] = clean_df['Value'].interpolate(
            method='linear', limit_direction='both'
        )

        return clean_df

    except FileNotFoundError:
        print(f"Warning: File non-existent -> {file_path}")
        return None
    except Exception as err:
        print(f"Failed parsing {file_path}: {err}")
        return None


# =====================================================================
# FORECAST ENGINE
# =====================================================================


def generate_damped_forecast(
    years, values, forecast_years, window=10, damping_factor=0.85
):
    recent_years = years[-window:]
    recent_values = values[-window:]

    res = linregress(recent_years, recent_values)
    initial_slope = res.slope
    last_historical_val = values[-1]
    last_historical_year = years[-1]

    forecasts = []
    current_val = last_historical_val
    current_slope = initial_slope

    for y in forecast_years:
        step_delta = y - last_historical_year
        effective_slope = current_slope * (damping_factor**step_delta)
        current_val = current_val + effective_slope
        forecasts.append(current_val)

    forecast_arr = np.array(forecasts)

    stderr = res.stderr if res.stderr and not np.isnan(res.stderr) else 0.5
    time_delta = forecast_years - last_historical_year
    uncertainty_margin = 1.28 * stderr * np.sqrt(time_delta)

    return (
        forecast_arr,
        forecast_arr - uncertainty_margin,
        forecast_arr + uncertainty_margin,
    )


# =====================================================================
# MAIN PIPELINE
# =====================================================================

historical_series = {}
for country_name, file_name in COUNTRY_FILES.items():
    df_clean = load_worldbank_csv(file_name, TARGET_CODE)
    if df_clean is not None and not df_clean.empty:
        historical_series[country_name] = df_clean

plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
fig, ax = plt.subplots(figsize=(14, 8), dpi=100)

future_years = np.arange(FORECAST_START, FORECAST_START + FORECAST_HORIZON)
max_hist_yr = 2026

for country_name, df_data in historical_series.items():
    years = df_data['Year'].values
    values = df_data['Value'].values
    color = COUNTRY_COLORS.get(country_name, '#333333')
    
    if years[-1] > max_hist_yr:
        max_hist_yr = years[-1]

    # Plot actual historical series
    ax.plot(
        years,
        values,
        label=f'{country_name} (Actual)',
        color=color,
        linewidth=2.5 if country_name == 'Ghana' else 1.8,
        zorder=4 if country_name == 'Ghana' else 3,
    )

    # Generate damped forecast for each nation
    pred, lower_ci, upper_ci = generate_damped_forecast(
        years, values, future_years
    )

    connect_years = np.append([years[-1]], future_years)
    connect_pred = np.append([values[-1]], pred)
    connect_lower = np.append([values[-1]], lower_ci)
    connect_upper = np.append([values[-1]], upper_ci)

    # Plot national damped forecast projection
    ax.plot(
        connect_years,
        connect_pred,
        linestyle=':',
        linewidth=2.0,
        color=color,
        label=f'{country_name} (Forecast)',
    )

    # Confidence interval band per nation
    ax.fill_between(
        connect_years,
        connect_lower,
        connect_upper,
        color=color,
        alpha=0.08,
    )

    # Endpoint value annotation
    ax.annotate(
        f'{pred[-1]:.1f}%',
        xy=(future_years[-1], pred[-1]),
        xytext=(5, -3),
        textcoords='offset points',
        fontsize=8.5,
        fontweight='bold',
        color=color,
    )

    # Ghana-specific peer accelerated target (+2.0%)
    if country_name == 'Ghana':
        accelerated_pred = pred + 2.0
        connect_accelerated = np.append([values[-1]], accelerated_pred)

        ax.plot(
            connect_years,
            connect_accelerated,
            label='Ghana: Accelerated Target (+2.0%)',
            color=ACCELERATED_COLOR,
            linestyle='-.',
            linewidth=2.2,
            zorder=5,
        )

        ax.annotate(
            f'{accelerated_pred[-1]:.1f}%',
            xy=(future_years[-1], accelerated_pred[-1]),
            xytext=(5, -3),
            textcoords='offset points',
            fontsize=8.5,
            fontweight='bold',
            color=ACCELERATED_COLOR,
        )

# Grid and vertical markers
ax.axvspan(
    max_hist_yr,
    FORECAST_START + FORECAST_HORIZON - 1,
    color='gray',
    alpha=0.06,
    zorder=1,
)
ax.axvline(
    x=max_hist_yr,
    color='#555555',
    linestyle='--',
    alpha=0.7,
    linewidth=1.2,
    label='Forecast Start Horizon',
)
ax.axhline(0, color='black', linewidth=0.9, alpha=0.8)

ax.set_title(
    f'Multi-Nation Economic Growth Projections (5-Year Horizon)\n{TARGET_NAME}',
    fontsize=14,
    fontweight='bold',
    pad=15,
)
ax.set_xlabel('Year', fontsize=11, fontweight='bold', labelpad=10)
ax.set_ylabel('Annual Growth Rate (%)', fontsize=11, fontweight='bold', labelpad=10)
ax.set_xlim(left=1995, right=FORECAST_START + FORECAST_HORIZON + 1)

ax.legend(
    loc='upper left',
    bbox_to_anchor=(1.01, 1),
    frameon=True,
    facecolor='white',
    edgecolor='#cccccc',
    fontsize=9,
)

plt.tight_layout()
plt.show()
